# --- Core (required) ---
DATABASE_URL=sqlite:///./booktutor.db
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080
FRONTEND_ORIGIN=http://localhost:3000
MAX_UPLOAD_MB=500
UPLOAD_STORAGE_DIR=./storage/uploads

# --- LLM (optional) ---
# Free key at https://console.groq.com — without it, insight/flashcard
# generation falls back to a simple offline heuristic so the app still runs.
GROQ_API_KEY=

# --- Telegram (optional, free, no approval process) ---
# Get a token from @BotFather on Telegram — see NOTIFICATIONS.md
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# --- WhatsApp (optional, requires Meta Business verification) ---
# See NOTIFICATIONS.md for the full setup (template approval takes 1-2 days)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=daily_lesson_ready

# --- Razorpay (optional, for subscriptions) ---
# See BILLING.md for setup
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID_MONTHLY=
RAZORPAY_PLAN_ID_YEARLY=
